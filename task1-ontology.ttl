###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#SohoPizza
:SohoPizza rdf:type owl:Class ;
           rdfs:subClassOf :CheesyPizza ,
                           :InterestingPizza ,
                           :NamedPizza ,
                           :VegetarianPizza ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :MozzarellaTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :OliveTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :ParmesanTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :TomatoTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:allValuesFrom [ rdf:type owl:Class ;
                                                 owl:unionOf ( :MozzarellaTopping
                                                               :OliveTopping
                                                               :ParmesanTopping
                                                               :TomatoTopping
                                                             )
                                               ]
                           ] ;
           owl:disjointWith :SpicyBeefTopping ,
                            :ThinAndCrispyBase ,
                            :TomatoTopping ,
                            :TunaTopping ,
                            :VegetableTopping ;
           rdfs:comment "A pizza that only has Mozzarella, Olive and Tomato toppings." .


###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#Spiciness
:Spiciness rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( :Hot
                                             :Medium
                                             :Mild
                                           )
                               ] .


