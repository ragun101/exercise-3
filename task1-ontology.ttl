###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#SpicyPizza
:SpicyPizza rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasTopping ;
                                                         owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasSpiciness ;
                                                                              owl:hasValue :Hot
                                                                            ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Pizza ;
            owl:disjointWith :ThinAndCrispyBase ,
                             :TomatoTopping ,
                             :TunaTopping ,
                             :VegetableTopping .


