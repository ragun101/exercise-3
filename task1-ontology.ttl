###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#PepperTopping
:PepperTopping rdf:type owl:Class ;
               rdfs:subClassOf :VegetableTopping ;
               owl:disjointWith :PepperoniTopping ,
                                :Pizza ,
                                :PizzaBase ,
                                :PrawnTopping ,
                                :SalamiTopping ,
                                :SeafoodTopping ,
                                :SohoPizza ,
                                :SpicyBeefTopping ,
                                :SpicyPizza ,
                                :ThinAndCrispyBase ,
                                :TomatoTopping ,
                                :TunaTopping ,
                                :VegetarianPizza .


###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#PepperoniTopping
:PepperoniTopping rdf:type owl:Class ;
                  rdfs:subClassOf :MeatTopping ;
                  owl:disjointWith :Pizza ,
                                   :PizzaBase ,
                                   :PrawnTopping ,
                                   :RedPepperTopping ,
                                   :SalamiTopping ,
                                   :SeafoodTopping ,
                                   :SohoPizza ,
                                   :SpicyBeefTopping ,
                                   :SpicyPizza ,
                                   :ThinAndCrispyBase ,
                                   :TomatoTopping ,
                                   :TunaTopping ,
                                   :VegetableTopping ,
                                   :VegetarianPizza .


###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#Pizza
:Pizza rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBase ;
                         owl:someValuesFrom :PizzaBase
                       ] ;
       owl:disjointWith :PizzaBase ,
                        :PizzaTopping ,
                        :PrawnTopping ,
                        :RedPepperTopping ,
                        :SalamiTopping ,
                        :SeafoodTopping ,
                        :SpicyBeefTopping ,
                        :ThinAndCrispyBase ,
                        :TomatoTopping ,
                        :TunaTopping ,
                        :VegetableTopping .


###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#PizzaBase
:PizzaBase rdf:type owl:Class ;
           owl:disjointWith :PizzaTopping ,
                            :PrawnTopping ,
                            :RedPepperTopping ,
                            :SalamiTopping ,
                            :SeafoodTopping ,
                            :SohoPizza ,
                            :SpicyBeefTopping ,
                            :SpicyPizza ,
                            :TomatoTopping ,
                            :TunaTopping ,
                            :VegetableTopping ,
                            :VegetarianPizza .


###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#PizzaTopping
:PizzaTopping rdf:type owl:Class ;
              owl:disjointWith :SohoPizza ,
                               :SpicyPizza ,
