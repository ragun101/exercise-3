###  http://www.semanticweb.org/rapha/ontologies/2026/2/PizzaTutorial#ParmesanTopping
:ParmesanTopping rdf:type owl:Class ;
                 rdfs:subClassOf :CheeseTopping ;
                 owl:disjointWith :PepperTopping ,
                                  :PepperoniTopping ,
                                  :Pizza ,
                                  :PizzaBase ,
                                  :PrawnTopping ,
                                  :RedPepperTopping ,
                                  :SalamiTopping ,
                                  :SeafoodTopping ,
                                  :SohoPizza ,
                                  :SpicyBeefTopping ,
                                  :SpicyPizza ,
