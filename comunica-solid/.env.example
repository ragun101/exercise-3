SOLID_ENDPOINT=http://localhost:3000
SOLID_USERNAME=my-email@example.com
SOLID_PASSWORD=my-password
# Quotes are required to preserve the #me fragment (dotenv treats # as inline comment)
SOLID_WEBID="http://localhost:3000/my-pod/card#me"
# Optional: override pod base URL (defaults to pod derived from SOLID_WEBID)
# SOLID_POD=http://localhost:3000/other-pod/
