# ═══════════════════════════════════════════════════════════════════
# ABox: Thing Description for the TextSearcher tool (Text Search)
#
# UPLOAD INSTRUCTIONS:
# Upload this Thing Description to your Solid Pod using the Write
# panel. Each tool's TD should be in its own container, e.g.:
#   https://wiser-solid-xi.interactions.ics.unisg.ch/YOUR-POD/tools/text-searcher
#
# NOTE: Fragment URIs like <#searchText> resolve relative to the
# document URL. When referencing this action from another document
# (e.g., a Workflow composition), use the full URI.
# ═══════════════════════════════════════════════════════════════════

@prefix td:         <https://www.w3.org/2019/wot/td#> .
@prefix jsonschema: <https://www.w3.org/2019/wot/json-schema#> .
@prefix wotsec:     <https://www.w3.org/2019/wot/security#> .
@prefix hctl:       <https://www.w3.org/2019/wot/hypermedia#> .
@prefix htv:        <http://www.w3.org/2011/http#> .
@prefix dct:        <http://purl.org/dc/terms/> .

# ─── The Thing ────────────────────────────────────────────────
# A WoT Thing representing the TextSearcher tool on the sandbox computer.
# It has one action affordance: searchText.

<#textSearcherThing> a td:Thing ;
    td:title "Text Search Tool" ;
    td:hasSecurityConfiguration <#textSearcherThing-nosec> ;
    td:hasActionAffordance <#searchText> .

<#textSearcherThing-nosec> a wotsec:NoSecurityScheme ;
    dct:title "No Security" .

# ─── Action: searchText ──────────────────────────────────────
# An ActionAffordance with typed input and output schemas.

<#searchText> a td:ActionAffordance ;
    td:name "searchText" ;
    td:title "Search Text" ;
    td:description "Searches text content for lines matching a regex pattern." ;
    td:hasInputSchema <#textInputSchema> ;
    td:hasOutputSchema <#textOutputSchema> ;
    td:hasForm [
        a hctl:Form ;
        hctl:hasTarget <https://api.example.org/search-text> ;
        hctl:hasOperationType td:invokeAction ;
        hctl:forContentType "application/json" ;
        htv:methodName "POST"
    ] .

# ─── Schemas ──────────────────────────────────────────────────
# The schemas describe the input/output data types of the action.

<#textInputSchema> a jsonschema:ObjectSchema ;
    jsonschema:contentMediaType "text/plain" ;
    jsonschema:properties [
        a jsonschema:StringSchema ;
        jsonschema:propertyName "pattern" ;
        td:description "The regex pattern to search for."
    ] , [
        a jsonschema:StringSchema ;
        jsonschema:propertyName "input" ;
        td:description "The text content to search through."
    ] ;
    jsonschema:required "pattern" .

<#textOutputSchema> a jsonschema:ObjectSchema ;
    jsonschema:contentMediaType "text/plain" ;
    jsonschema:properties [
        a jsonschema:StringSchema ;
        jsonschema:propertyName "matches" ;
        td:description "Lines matching the pattern."
    ] .
